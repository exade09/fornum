# Phone verification. Twilio Verify sends the code over WhatsApp or SMS from a
# single API and ships its own Meta approved authentication templates, so there
# is no template review. Leave these unset and the flow runs on a local stub
# that accepts the code 000000.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Signs the session cookie and salts the phone hash. Any long random string.
AUTH_SECRET=

# Optional. Pins counters shown on the site, overriding content/site-config.json
# FORNUM_OVERRIDES={"callsInQueue":2,"callsLive":1}

# Optional. Defaults to the public mainnet endpoint, which is rate limited.
# SOLANA_RPC_URL=
