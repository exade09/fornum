# Database. Postgres over a pooler works, so does Neon or Supabase. Without it
# the app runs on an in memory store that resets on restart, which is fine for
# looking around and useless for anything else. Schema lives in db/schema.sql
DATABASE_URL=

# The wallet that deploys mints and therefore collects their creator fees. A
# claim is a transfer out of it. Base58 secret key, or the JSON byte array that
# solana-keygen writes. Without it claims are refused rather than faked.
LAUNCH_WALLET_SECRET=

# Guards the operator endpoint that records a launch. Any long random string.
ADMIN_TOKEN=

# Signs the session cookie and salts the phone hash. Any long random string.
AUTH_SECRET=

# Phone verification for sign in. Twilio Verify covers SMS and WhatsApp from one
# API. Leave unset and the flow runs on a stub that accepts the code 000000.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Solana RPC. Defaults to the public mainnet endpoint, which is rate limited.
SOLANA_RPC_URL=

# Optional. Pins counters, overriding content/site-config.json
# FORNUM_OVERRIDES={"tokensLaunched":3}
